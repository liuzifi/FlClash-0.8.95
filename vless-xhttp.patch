--- a/adapter/outbound/vless.go
+++ b/adapter/outbound/vless.go
@@ -299,6 +299,24 @@ func (v *Vless) streamConnContext(ctx context.Context, c net.Conn, metadata *C.Metadata) (conn net.Conn, err error) {
 	}
 	if err != nil {
 		conn = nil
+		return
+	}
+	// For xhttp transport, proactively flush the vless handshake header by
+	// writing an empty payload. This triggers sendRequest with a zero-length
+	// payload, sending the full vless request header (version + uuid +
+	// addons + command + port + addr) to the server so it can return the
+	// response header immediately. Without this, the first Read on the conn
+	// would block in recvResponse waiting for the server's 2-byte response,
+	// while the server waits for our request body — a deadlock in xhttp
+	// stream-one mode where the response body arrives asynchronously via
+	// WaitReadCloser. Trojan does not have this issue because
+	// trojan.WriteHeader is called eagerly before returning the conn.
+	// Only apply to TCP streams; UDP (PacketConn) flushes its own handshake.
+	if v.option.Network == "xhttp" && metadata.NetWork != C.UDP {
+		if _, werr := conn.Write([]byte{}); werr != nil {
+			conn = nil
+			err = werr
+		}
 	}
 	return
 }
