diff -ruN a/lib/common/yaml_folding.dart b/lib/common/yaml_folding.dart
--- a/lib/common/yaml_folding.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/common/yaml_folding.dart	2026-10-26 00:37:15.485999450 +0900
@@ -0,0 +1,79 @@
+class FoldRange {
+  final int start;
+  final int end;
+
+  const FoldRange(this.start, this.end);
+
+  @override
+  bool operator ==(Object other) =>
+      other is FoldRange && other.start == start && other.end == end;
+
+  @override
+  int get hashCode => Object.hash(start, end);
+
+  @override
+  String toString() => 'FoldRange($start, $end)';
+}
+
+class _Entry {
+  final int index;
+  final int level;
+  final bool opensBlock;
+
+  const _Entry(this.index, this.level, this.opensBlock);
+}
+
+int _indentOf(String text) {
+  var i = 0;
+  while (i < text.length && text.codeUnitAt(i) == 0x20) {
+    i++;
+  }
+  if (i >= text.length) return -1;
+  final rest = text.substring(i).trimRight();
+  if (rest.isEmpty || rest.startsWith('#')) return -1;
+  return i;
+}
+
+bool _isSequenceItem(String trimmed) =>
+    trimmed == '-' || trimmed.startsWith('- ');
+
+bool _opensBlock(String trimmed) {
+  var line = trimmed;
+  final comment = line.indexOf(' #');
+  if (comment >= 0) line = line.substring(0, comment).trimRight();
+  if (line.endsWith(':')) return true;
+  return RegExp(r':\s+[|>][+\-0-9]*$').hasMatch(line);
+}
+
+List<FoldRange> computeYamlFoldRanges(List<String> lines) {
+  final ranges = <FoldRange>[];
+  final stack = <_Entry>[];
+  var lastContent = -1;
+
+  void closeUntil(int level) {
+    while (stack.isNotEmpty && stack.last.level >= level) {
+      final entry = stack.removeLast();
+      if (lastContent > entry.index) {
+        ranges.add(FoldRange(entry.index, lastContent));
+      }
+    }
+  }
+
+  for (var i = 0; i < lines.length; i++) {
+    final text = lines[i];
+    final indent = _indentOf(text);
+    if (indent < 0) continue;
+    final trimmed = text.substring(indent).trimRight();
+    var level = indent * 2;
+    if (_isSequenceItem(trimmed) &&
+        stack.any((e) => e.level == level && e.opensBlock)) {
+      level += 1;
+    }
+    closeUntil(level);
+    stack.add(_Entry(i, level, _opensBlock(trimmed)));
+    lastContent = i;
+  }
+  closeUntil(0);
+  ranges.sort((a, b) => a.start - b.start);
+  return ranges;
+}
diff -ruN a/lib/common/yaml_outline.dart b/lib/common/yaml_outline.dart
--- a/lib/common/yaml_outline.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/common/yaml_outline.dart	2026-10-26 00:37:15.486573610 +0900
@@ -0,0 +1,197 @@
+class OutlineItem {
+  final int line;
+  final String title;
+  final int level;
+
+  const OutlineItem({
+    required this.line,
+    required this.title,
+    required this.level,
+  });
+}
+
+final _topKeyReg = RegExp(r'^([^\s#\-][^:]*):(?:\s|$)');
+final _keyReg = RegExp(r'^([^\s,{\[#"' "'" r'][^,:]*|"[^"]*"|' "'[^']*'" r'):(?:\s|$)');
+final _nameReg = RegExp(r'^name:\s*(.*)$');
+final _flowNameReg = RegExp(r'''name:\s*("[^"]*"|'[^']*'|[^,}]+)''');
+final _errorLineReg = RegExp(r'line\s+(\d+)', caseSensitive: false);
+
+int? parseErrorLine(String message) {
+  final match = _errorLineReg.firstMatch(message);
+  if (match == null) {
+    return null;
+  }
+  final line = int.tryParse(match.group(1)!);
+  if (line == null || line < 1) {
+    return null;
+  }
+  return line;
+}
+
+String _cleanValue(String raw) {
+  final value = raw.trim();
+  if (value.isEmpty) {
+    return value;
+  }
+  final first = value[0];
+  if (first == '"' || first == "'") {
+    final end = value.indexOf(first, 1);
+    if (end > 0) {
+      return value.substring(1, end);
+    }
+    return value.substring(1);
+  }
+  final comment = value.indexOf(' #');
+  if (comment >= 0) {
+    return value.substring(0, comment).trim();
+  }
+  return value;
+}
+
+int _indentOf(String line) {
+  int i = 0;
+  while (i < line.length && line[i] == ' ') {
+    i++;
+  }
+  return i;
+}
+
+bool _isSkippable(String line) {
+  final trimmed = line.trim();
+  return trimmed.isEmpty || trimmed.startsWith('#');
+}
+
+bool _isSeqItem(String trimmed) {
+  return trimmed == '-' || trimmed.startsWith('- ');
+}
+
+String _listItemTitle(List<String> lines, int index, int indent, int ordinal) {
+  final trimmed = lines[index].trim();
+  final rest = trimmed == '-' ? '' : trimmed.substring(2).trimLeft();
+  if (rest.startsWith('{')) {
+    final match = _flowNameReg.firstMatch(rest);
+    if (match != null) {
+      final value = _cleanValue(match.group(1)!);
+      if (value.isNotEmpty) {
+        return value;
+      }
+    }
+    return '#$ordinal';
+  }
+  if (rest.isNotEmpty && !_keyReg.hasMatch(rest)) {
+    final value = _cleanValue(rest);
+    return value.isEmpty ? '#$ordinal' : value;
+  }
+  final contentIndent = rest.isEmpty
+      ? indent + 2
+      : indent + (trimmed.length - rest.length);
+  final inline = _nameReg.firstMatch(rest);
+  if (inline != null) {
+    final value = _cleanValue(inline.group(1)!);
+    if (value.isNotEmpty) {
+      return value;
+    }
+  }
+  for (int j = index + 1; j < lines.length && j <= index + 40; j++) {
+    final next = lines[j].trimRight();
+    if (_isSkippable(next)) {
+      continue;
+    }
+    final nextIndent = _indentOf(next);
+    final nextTrimmed = next.trim();
+    if (nextIndent < contentIndent ||
+        (nextIndent == indent && _isSeqItem(nextTrimmed))) {
+      break;
+    }
+    if (nextIndent == contentIndent) {
+      final match = _nameReg.firstMatch(nextTrimmed);
+      if (match != null) {
+        final value = _cleanValue(match.group(1)!);
+        if (value.isNotEmpty) {
+          return value;
+        }
+      }
+    }
+  }
+  return '#$ordinal';
+}
+
+List<OutlineItem> parseYamlOutline(String text) {
+  final lines = text.split('\n').map((line) => line.trimRight()).toList();
+  final items = <OutlineItem>[];
+  bool inSection = false;
+  int? childIndent;
+  int ordinal = 0;
+  for (int i = 0; i < lines.length; i++) {
+    final line = lines[i];
+    if (_isSkippable(line)) {
+      continue;
+    }
+    final indent = _indentOf(line);
+    final trimmed = line.trim();
+    if (indent == 0 && !_isSeqItem(trimmed)) {
+      final match = _topKeyReg.firstMatch(line);
+      if (match != null) {
+        items.add(
+          OutlineItem(
+            line: i,
+            title: _cleanValue(match.group(1)!),
+            level: 0,
+          ),
+        );
+        inSection = true;
+        childIndent = null;
+        ordinal = 0;
+      } else {
+        inSection = false;
+      }
+      continue;
+    }
+    if (!inSection) {
+      continue;
+    }
+    childIndent ??= indent;
+    if (indent != childIndent) {
+      continue;
+    }
+    if (_isSeqItem(trimmed)) {
+      ordinal++;
+      items.add(
+        OutlineItem(
+          line: i,
+          title: _listItemTitle(lines, i, indent, ordinal),
+          level: 1,
+        ),
+      );
+    } else {
+      final match = _keyReg.firstMatch(trimmed);
+      if (match != null) {
+        items.add(
+          OutlineItem(
+            line: i,
+            title: _cleanValue(match.group(1)!),
+            level: 1,
+          ),
+        );
+      }
+    }
+  }
+  return items;
+}
+
+int? findTopLevelKeyLine(List<String> lines, String key) {
+  final reg = RegExp('^${RegExp.escape(key)}:(?:\\s|\$)');
+  for (var i = 0; i < lines.length; i++) {
+    if (reg.hasMatch(lines[i])) {
+      return i;
+    }
+  }
+  return null;
+}
+
+List<OutlineItem> outlineFromProxies(List<OutlineItem> items) {
+  final index = items.indexWhere(
+    (item) => item.level == 0 && item.title == 'proxies',
+  );
+  return index <= 0 ? items : items.sublist(index);
+}
