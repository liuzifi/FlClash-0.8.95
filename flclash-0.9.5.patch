+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+class CurrentProfileCard extends ConsumerWidget {
+  const CurrentProfileCard({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final appLocalizations = context.appLocalizations;
+    final profile = ref.watch(currentProfileProvider);
+    final groups = ref.watch(currentGroupsStateProvider).value;
+    final currentGroupName = profile?.currentGroupName;
+    final group = groups.isEmpty
+        ? null
+        : groups.firstWhere(
+            (item) => item.name == currentGroupName,
+            orElse: () => groups.first,
+          );
+    final nodeName = group == null
+        ? null
+        : ref.watch(selectedProxyNameProvider(group.name));
+    final title = profile == null
+        ? appLocalizations.none
+        : profile.label.takeFirstValid([profile.id.toString()]);
+    final subtitle = group == null
+        ? null
+        : nodeName == null || nodeName.isEmpty
+        ? group.name
+        : '${group.name} › $nodeName';
+    return SizedBox(
+      height: getWidgetHeight(1),
+      child: CommonCard(
+        info: Info(
+          label: appLocalizations.currentProfile,
+          iconData: Icons.article_outlined,
+        ),
+        onPressed: () {
+          globalState.container
+              .read(currentPageLabelProvider.notifier)
+              .toPage(group == null ? PageLabel.profiles : PageLabel.proxies);
+        },
+        child: Container(
+          padding: baseInfoEdgeInsets.copyWith(top: 0),
+          child: Column(
+            mainAxisSize: MainAxisSize.max,
+            mainAxisAlignment: MainAxisAlignment.end,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              TooltipText(
+                text: Text(
+                  title,
+                  style: context.textTheme.titleMedium,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                ),
+              ),
+              if (subtitle != null)
+                TooltipText(
+                  text: Text(
+                    subtitle,
+                    style: context.textTheme.bodyMedium?.toLight,
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                  ),
+                ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
diff -ruN a/lib/views/dashboard/widgets/favorite_proxies.dart b/lib/views/dashboard/widgets/favorite_proxies.dart
--- a/lib/views/dashboard/widgets/favorite_proxies.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/views/dashboard/widgets/favorite_proxies.dart	2026-10-26 00:37:15.500126512 +0900
@@ -0,0 +1,230 @@
+import 'package:fl_clash/common/common.dart';
+import 'package:fl_clash/common/favorite_proxies.dart';
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/models.dart';
+import 'package:fl_clash/providers/providers.dart';
+import 'package:fl_clash/state.dart';
+import 'package:fl_clash/views/proxies/common.dart';
+import 'package:fl_clash/widgets/widgets.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+class FavoriteProxiesCard extends ConsumerStatefulWidget {
+  const FavoriteProxiesCard({super.key});
+
+  @override
+  ConsumerState<FavoriteProxiesCard> createState() =>
+      _FavoriteProxiesCardState();
+}
+
+class _FavoriteProxiesCardState extends ConsumerState<FavoriteProxiesCard> {
+  final ScrollController _scrollController = ScrollController();
+  bool _testing = false;
+
+  @override
+  void dispose() {
+    _scrollController.dispose();
+    super.dispose();
+  }
+
+  Future<void> _handleTestAll(List<ResolvedFavorite> items) async {
+    if (_testing) {
+      return;
+    }
+    final targets = items.where((item) => item.exists).toList();
+    if (targets.isEmpty) {
+      return;
+    }
+    setState(() {
+      _testing = true;
+    });
+    try {
+      for (final batch in targets.batch(100)) {
+        await Future.wait(
+          batch.map((item) => proxyDelayTest(item.proxy!, item.group!.testUrl)),
+        );
+      }
+      globalState.container.read(sortNumProvider.notifier).add();
+    } finally {
+      if (mounted) {
+        setState(() {
+          _testing = false;
+        });
+      }
+    }
+  }
+
+  Widget _buildTestButton(List<ResolvedFavorite> items) {
+    if (_testing) {
+      return const Padding(
+        padding: EdgeInsets.all(12),
+        child: SizedBox(
+          width: 20,
+          height: 20,
+          child: CommonCircleLoading(),
+        ),
+      );
+    }
+    return IconButton(
+      tooltip: context.appLocalizations.delayTest,
+      onPressed: items.any((item) => item.exists)
+          ? () => _handleTestAll(items)
+          : null,
+      icon: const Icon(Icons.bolt),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final appLocalizations = context.appLocalizations;
+    final favorites = ref.watch(currentFavoriteProxiesProvider);
+    final groups = ref.watch(groupsProvider);
+    final resolved = [for (final f in favorites) resolveFavorite(f, groups)];
+    return SizedBox(
+      height: getWidgetHeight(4),
+      child: CommonCard(
+        onPressed: () {},
+        child: Column(
+          children: [
+            InfoHeader(
+              info: Info(
+                label: appLocalizations.favoriteProxies,
+                iconData: Icons.star_outline,
+              ),
+              actions: [_buildTestButton(resolved)],
+            ),
+            Expanded(
+              child: resolved.isEmpty
+                  ? Padding(
+                      padding: baseInfoEdgeInsets.copyWith(top: 0),
+                      child: Align(
+                        alignment: Alignment.topLeft,
+                        child: Text(
+                          appLocalizations.favoriteEmptyTip,
+                          style: context.textTheme.bodyMedium?.toLight,
+                        ),
+                      ),
+                    )
+                  : CommonScrollBar(
+                      controller: _scrollController,
+                      child: ListView.builder(
+                        controller: _scrollController,
+                        padding: const EdgeInsets.only(bottom: 8),
+                        itemCount: resolved.length,
+                        itemBuilder: (_, index) =>
+                            _FavoriteRow(item: resolved[index]),
+                      ),
+                    ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _FavoriteRow extends ConsumerWidget {
+  final ResolvedFavorite item;
+
+  const _FavoriteRow({required this.item});
+
+  void _handleSelect() {
+    final group = item.group;
+    final proxy = item.proxy;
+    if (group == null || proxy == null) {
+      return;
+    }
+    final isComputedSelected = group.type.isComputedSelected;
+    if (!isComputedSelected && group.type != GroupType.Selector) {
+      globalState.showNotifier(currentAppLocalizations.notSelectedTip);
+      return;
+    }
+    final container = globalState.container;
+    final current = container.read(proxyNameProvider(group.name));
+    final next = isComputedSelected && current == proxy.name ? '' : proxy.name;
+    container
+        .read(profilesActionProvider.notifier)
+        .updateCurrentSelectedMap(group.name, next);
+    container
+        .read(proxiesActionProvider.notifier)
+        .changeProxyDebounce(group.name, next);
+  }
+
+  void _handleRemove(WidgetRef ref) {
+    final profileId = ref.read(currentProfileIdProvider);
+    if (profileId == null) {
+      return;
+    }
+    ref
+        .read(favoriteProxiesProvider.notifier)
+        .toggle(profileId.toString(), item.favorite);
+  }
+
+  Widget _buildDelay(BuildContext context, WidgetRef ref) {
+    final proxy = item.proxy!;
+    final testUrl = item.group?.testUrl;
+    final delay = ref.watch(
+      delayProvider(proxyName: proxy.name, testUrl: testUrl),
+    );
+    if (delay == 0) {
+      return const SizedBox(
+        width: 18,
+        height: 18,
+        child: CommonCircleLoading(),
+      );
+    }
+    return InkResponse(
+      onTap: () => proxyDelayTest(proxy, testUrl),
+      child: delay == null
+          ? const Icon(Icons.bolt, size: 18)
+          : Text(
+              delay > 0 ? '$delay ms' : 'Timeout',
+              style: context.textTheme.labelSmall?.copyWith(
+                color: utils.getDelayColor(delay),
+              ),
+            ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final appLocalizations = context.appLocalizations;
+    final exists = item.exists;
+    final selected =
+        exists &&
+        ref.watch(selectedProxyNameProvider(item.group!.name)) ==
+            item.favorite.name;
+    return ListTile(
+      dense: true,
+      enabled: exists,
+      contentPadding: const EdgeInsets.only(left: 16, right: 4),
+      onTap: exists ? _handleSelect : null,
+      leading: Icon(
+        selected ? Icons.check_circle : Icons.radio_button_unchecked,
+        size: 20,
+        color: selected ? context.colorScheme.primary : null,
+      ),
+      title: Text(
+        item.favorite.name,
+        maxLines: 1,
+        overflow: TextOverflow.ellipsis,
+      ),
+      subtitle: Text(
+        exists ? item.favorite.group : appLocalizations.favoriteMissing,
+        maxLines: 1,
+        overflow: TextOverflow.ellipsis,
+      ),
+      trailing: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          if (exists) _buildDelay(context, ref),
+          IconButton(
+            visualDensity: VisualDensity.compact,
+            icon: const Icon(Icons.star, color: Colors.amber, size: 20),
+            onPressed: () => _handleRemove(ref),
+          ),
+        ],
+      ),
+    );
+  }
+}
