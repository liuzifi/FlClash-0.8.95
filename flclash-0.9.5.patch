diff -ruN a/lib/common/dns_validator.dart b/lib/common/dns_validator.dart
--- a/lib/common/dns_validator.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/common/dns_validator.dart	2026-10-26 00:37:15.478192750 +0900
@@ -0,0 +1,95 @@
+const _dnsSchemes = {
+  'udp', 'tcp', 'tls', 'https', 'quic', 'h3', 'dhcp', 'system', 'rcode',
+};
+
+final _hostLabel = RegExp(r'^[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?$');
+
+bool _isIpv4(String s) {
+  final parts = s.split('.');
+  if (parts.length != 4) return false;
+  return parts.every((p) {
+    final n = int.tryParse(p);
+    return n != null && n >= 0 && n <= 255 && p == n.toString();
+  });
+}
+
+bool _isIpv6(String s) {
+  if (!s.contains(':')) return false;
+  try {
+    Uri.parseIPv6Address(s);
+    return true;
+  } catch (_) {
+    return false;
+  }
+}
+
+bool _isHostname(String s) {
+  if (s.isEmpty || s.length > 253) return false;
+  return s.split('.').every(_hostLabel.hasMatch);
+}
+
+bool _isPort(String s) {
+  final n = int.tryParse(s);
+  return n != null && n > 0 && n <= 65535 && s == n.toString();
+}
+
+bool _isHostPort(String s) {
+  if (s.isEmpty) return false;
+  if (s.startsWith('[')) {
+    final end = s.indexOf(']');
+    if (end < 0) return false;
+    final host = s.substring(1, end);
+    final rest = s.substring(end + 1);
+    if (!_isIpv6(host)) return false;
+    return rest.isEmpty || (rest.startsWith(':') && _isPort(rest.substring(1)));
+  }
+  if (_isIpv6(s)) return true;
+  final idx = s.lastIndexOf(':');
+  if (idx >= 0) {
+    if (s.indexOf(':') != idx) return false;
+    if (!_isPort(s.substring(idx + 1))) return false;
+    s = s.substring(0, idx);
+  }
+  return _isIpv4(s) || _isHostname(s);
+}
+
+bool isValidDnsServer(String input) {
+  var value = input.trim();
+  if (value.isEmpty || value.contains(RegExp(r'\s'))) return false;
+  final hash = value.indexOf('#');
+  if (hash >= 0) {
+    value = value.substring(0, hash);
+    if (value.isEmpty) return false;
+  }
+  if (value == 'system') return true;
+  final sep = value.indexOf('://');
+  if (sep < 0) return _isHostPort(value);
+  final scheme = value.substring(0, sep).toLowerCase();
+  if (!_dnsSchemes.contains(scheme)) return false;
+  var rest = value.substring(sep + 3);
+  if (rest.isEmpty) return false;
+  if (scheme == 'dhcp' || scheme == 'rcode') return true;
+  final slash = rest.indexOf('/');
+  if (slash >= 0) {
+    if (scheme != 'https' && scheme != 'h3') return false;
+    rest = rest.substring(0, slash);
+  }
+  return _isHostPort(rest);
+}
+
+bool isValidDnsServerList(String input) {
+  final parts = input.split(',').map((e) => e.trim()).toList();
+  return parts.isNotEmpty && parts.every(isValidDnsServer);
+}
+
+bool isValidCidr(String input) {
+  final value = input.trim();
+  final slash = value.indexOf('/');
+  if (slash <= 0) return false;
+  final ip = value.substring(0, slash);
+  final bits = int.tryParse(value.substring(slash + 1));
+  if (bits == null || bits < 0) return false;
+  if (_isIpv4(ip)) return bits <= 32;
+  if (_isIpv6(ip)) return bits <= 128;
+  return false;
+}
diff -ruN a/lib/common/editor_draft.dart b/lib/common/editor_draft.dart
--- a/lib/common/editor_draft.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/common/editor_draft.dart	2026-10-26 00:37:15.482102774 +0900
@@ -0,0 +1,55 @@
+import 'dart:convert';
+import 'dart:io';
+
+int stableHash(String text) {
+  var hash = 0x811c9dc5;
+  for (final unit in text.codeUnits) {
+    hash ^= unit;
+    hash = (hash * 0x01000193) & 0xffffffff;
+  }
+  return hash;
+}
+
+class EditorDraft {
+  final Directory dir;
+
+  const EditorDraft(this.dir);
+
+  File _file(String key) {
+    final safe = key.replaceAll(RegExp(r'[^A-Za-z0-9_.-]'), '_');
+    return File('${dir.path}${Platform.pathSeparator}$safe.json');
+  }
+
+  Future<void> save(String key, String base, String text) async {
+    final file = _file(key);
+    await file.create(recursive: true);
+    await file.writeAsString(
+      json.encode({'base': stableHash(base), 'text': text}),
+    );
+  }
+
+  Future<String?> load(String key, String base) async {
+    final file = _file(key);
+    if (!await file.exists()) {
+      return null;
+    }
+    try {
+      final data = json.decode(await file.readAsString());
+      final text = data['text'];
+      if (data['base'] == stableHash(base) &&
+          text is String &&
+          text != base) {
+        return text;
+      }
+    } catch (_) {}
+    await clear(key);
+    return null;
+  }
+
+  Future<void> clear(String key) async {
+    final file = _file(key);
+    if (await file.exists()) {
+      await file.delete();
+    }
+  }
+}
diff -ruN a/lib/common/favorite_proxies.dart b/lib/common/favorite_proxies.dart
--- a/lib/common/favorite_proxies.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/common/favorite_proxies.dart	2026-10-26 00:37:15.482900897 +0900
@@ -0,0 +1,99 @@
+import 'dart:convert';
+
+import 'package:fl_clash/models/models.dart';
+
+class FavoriteProxy {
+  final String group;
+  final String name;
+
+  const FavoriteProxy(this.group, this.name);
+
+  @override
+  bool operator ==(Object other) =>
+      other is FavoriteProxy && other.group == group && other.name == name;
+
+  @override
+  int get hashCode => Object.hash(group, name);
+
+  Map<String, String> toJson() => {'group': group, 'name': name};
+
+  static FavoriteProxy? fromJson(Object? json) {
+    if (json is! Map) return null;
+    final group = json['group'];
+    final name = json['name'];
+    if (group is String && name is String) {
+      return FavoriteProxy(group, name);
+    }
+    return null;
+  }
+}
+
+typedef FavoriteMap = Map<String, List<FavoriteProxy>>;
+
+String encodeFavorites(FavoriteMap map) {
+  return json.encode(
+    map.map((key, value) => MapEntry(key, value.map((e) => e.toJson()).toList())),
+  );
+}
+
+FavoriteMap decodeFavorites(String? raw) {
+  if (raw == null || raw.isEmpty) return {};
+  try {
+    final data = json.decode(raw);
+    if (data is! Map) return {};
+    final result = <String, List<FavoriteProxy>>{};
+    for (final entry in data.entries) {
+      final list = entry.value;
+      if (entry.key is! String || list is! List) continue;
+      final items = <FavoriteProxy>[];
+      for (final item in list) {
+        final fav = FavoriteProxy.fromJson(item);
+        if (fav != null && !items.contains(fav)) items.add(fav);
+      }
+      if (items.isNotEmpty) result[entry.key as String] = items;
+    }
+    return result;
+  } catch (_) {
+    return {};
+  }
+}
+
+List<FavoriteProxy> toggleFavorite(
+  List<FavoriteProxy> list,
+  FavoriteProxy favorite,
+) {
+  if (list.contains(favorite)) {
+    return list.where((e) => e != favorite).toList();
+  }
+  return [...list, favorite];
+}
+
+FavoriteMap pruneFavorites(FavoriteMap map, Set<String> validProfileIds) {
+  if (validProfileIds.isEmpty) return map;
+  return {
+    for (final entry in map.entries)
+      if (validProfileIds.contains(entry.key) && entry.value.isNotEmpty)
+        entry.key: entry.value,
+  };
+}
+
+class ResolvedFavorite {
+  final FavoriteProxy favorite;
+  final Group? group;
+  final Proxy? proxy;
+
+  const ResolvedFavorite(this.favorite, this.group, this.proxy);
+
+  bool get exists => group != null && proxy != null;
+}
+
+ResolvedFavorite resolveFavorite(FavoriteProxy favorite, List<Group> groups) {
+  final group = groups.getGroup(favorite.group);
+  if (group == null) return ResolvedFavorite(favorite, null, null);
+  final index = group.all.indexWhere((e) => e.name == favorite.name);
+  return ResolvedFavorite(
+    favorite,
+    group,
+    index == -1 ? null : group.all[index],
+  );
+}
diff -ruN a/lib/common/geo_mirror.dart b/lib/common/geo_mirror.dart
--- a/lib/common/geo_mirror.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/common/geo_mirror.dart	2026-10-26 00:37:15.483417560 +0900
@@ -0,0 +1,32 @@
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/clash_config.dart';
+
+class GeoMirrorPreset {
+  final String name;
+  final Map<GeoResource, String> urls;
+
+  const GeoMirrorPreset(this.name, this.urls);
+}
+
+const _jsdelivrBase =
+    'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release';
+
+const geoMirrorPresets = <GeoMirrorPreset>[
+  GeoMirrorPreset('GitHub', defaultGeoXUrl),
+  GeoMirrorPreset('jsDelivr', {
+    GeoResource.MMDB: '$_jsdelivrBase/geoip.metadb',
+    GeoResource.ASN: '$_jsdelivrBase/GeoLite2-ASN.mmdb',
+    GeoResource.GEOIP: '$_jsdelivrBase/geoip.dat',
+    GeoResource.GEOSITE: '$_jsdelivrBase/geosite.dat',
+  }),
+];
+
+GeoMirrorPreset? detectGeoMirrorPreset(Map<GeoResource, String> current) {
+  for (final preset in geoMirrorPresets) {
+    final same = preset.urls.entries.every((e) => current[e.key] == e.value);
+    if (same) {
+      return preset;
+    }
+  }
+  return null;
+}
diff -ruN a/lib/common/light_mode.dart b/lib/common/light_mode.dart
--- a/lib/common/light_mode.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/lib/common/light_mode.dart	2026-10-26 00:55:23.698045011 +0900
@@ -0,0 +1,119 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/widgets.dart';
+
+const defaultLightModeDelayMinutes = 5;
+const lightModeDelayOptions = [1, 3, 5, 10, 15, 30, 60];
+
+class LightModeSetting {
+  final bool enabled;
+  final int delayMinutes;
+
+  const LightModeSetting({
+    this.enabled = false,
+    this.delayMinutes = defaultLightModeDelayMinutes,
+  });
+
+  LightModeSetting copyWith({bool? enabled, int? delayMinutes}) {
+    return LightModeSetting(
+      enabled: enabled ?? this.enabled,
+      delayMinutes: delayMinutes ?? this.delayMinutes,
+    );
+  }
+
+  @override
+  bool operator ==(Object other) =>
+      other is LightModeSetting &&
+      other.enabled == enabled &&
+      other.delayMinutes == delayMinutes;
+
+  @override
+  int get hashCode => Object.hash(enabled, delayMinutes);
+}
+
+String encodeLightMode(LightModeSetting setting) {
+  return json.encode({
+    'enabled': setting.enabled,
+    'delayMinutes': setting.delayMinutes,
+  });
+}
+
+LightModeSetting decodeLightMode(String? raw) {
+  if (raw == null || raw.isEmpty) {
+    return const LightModeSetting();
+  }
+  try {
+    final data = json.decode(raw);
+    if (data is! Map) {
+      return const LightModeSetting();
+    }
+    final enabled = data['enabled'];
+    final delay = data['delayMinutes'];
+    return LightModeSetting(
+      enabled: enabled is bool && enabled,
+      delayMinutes: delay is int && delay >= 1 && delay <= 600
+          ? delay
+          : defaultLightModeDelayMinutes,
+    );
+  } catch (_) {
+    return const LightModeSetting();
+  }
+}
+
+typedef LightModeTimerFactory =
+    Timer Function(Duration duration, void Function() callback);
+
+class LightModeScheduler {
+  final LightModeSetting Function() readSetting;
+  final bool Function() isCoreRunning;
+  final Future<void> Function() enter;
+  final LightModeTimerFactory _createTimer;
+  Timer? _timer;
+
+  LightModeScheduler({
+    required this.readSetting,
+    required this.isCoreRunning,
+    required this.enter,
+    LightModeTimerFactory? createTimer,
+  }) : _createTimer = createTimer ?? ((d, cb) => Timer(d, cb));
+
+  bool get isScheduled => _timer != null;
+
+  void onLifecycleChanged(AppLifecycleState state) {
+    switch (state) {
+      case AppLifecycleState.paused:
+      case AppLifecycleState.hidden:
+        _schedule();
+      case AppLifecycleState.resumed:
+      case AppLifecycleState.detached:
+        cancel();
+      case AppLifecycleState.inactive:
+        break;
+    }
+  }
+
+  void _schedule() {
+    if (_timer != null) {
+      return;
+    }
+    final setting = readSetting();
+    if (!setting.enabled) {
+      return;
+    }
+    _timer = _createTimer(Duration(minutes: setting.delayMinutes), _fire);
+  }
+
+  void _fire() {
+    _timer = null;
+    if (!readSetting().enabled || !isCoreRunning()) {
+      return;
+    }
+    unawaited(enter().catchError((_) {}));
+  }
+
+  void cancel() {
+    _timer?.cancel();
+    _timer = null;
+  }
+}
