+    page(application, l.applicationDesc, tools, applicationPage),
+    page(l.network, l.networkDesc, advanced, networkPage),
+    page(l.onDemand, l.onDemandDesc, advanced, (_) => const OnDemandView()),
+    page('DNS', l.dnsDesc, advanced, dnsPage),
+    page(
+      l.addedRules,
