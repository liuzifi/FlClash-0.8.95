diff -ruN a/test/common/light_mode_test.dart b/test/common/light_mode_test.dart
--- a/test/common/light_mode_test.dart	1970-01-01 09:00:00.000000000 +0900
+++ b/test/common/light_mode_test.dart	2026-10-26 00:55:55.627826347 +0900
@@ -0,0 +1,130 @@
+import 'dart:async';
+
+import 'package:fl_clash/common/light_mode.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class _FakeTimer implements Timer {
+  _FakeTimer(this.duration, this.callback);
+
+  final Duration duration;
+  final void Function() callback;
+  bool cancelled = false;
+
+  @override
+  void cancel() {
+    cancelled = true;
+  }
+
+  @override
+  bool get isActive => !cancelled;
+
+  @override
+  int get tick => 0;
+}
+
+void main() {
+  group('setting codec', () {
+    test('round trip', () {
+      const setting = LightModeSetting(enabled: true, delayMinutes: 15);
+      expect(decodeLightMode(encodeLightMode(setting)), setting);
+    });
+
+    test('garbage falls back to defaults', () {
+      expect(decodeLightMode(null), const LightModeSetting());
+      expect(decodeLightMode('nope'), const LightModeSetting());
+      expect(decodeLightMode('[1]'), const LightModeSetting());
+      expect(
+        decodeLightMode('{"enabled":true,"delayMinutes":-3}'),
+        const LightModeSetting(enabled: true),
+      );
+    });
+  });
+
+  group('scheduler', () {
+    late List<_FakeTimer> timers;
+    late LightModeSetting setting;
+    late bool running;
+    late int entered;
+    late LightModeScheduler scheduler;
+
+    setUp(() {
+      timers = [];
+      setting = const LightModeSetting(enabled: true, delayMinutes: 3);
+      running = true;
+      entered = 0;
+      scheduler = LightModeScheduler(
+        readSetting: () => setting,
+        isCoreRunning: () => running,
+        enter: () async {
+          entered++;
+        },
+        createTimer: (duration, callback) {
+          final timer = _FakeTimer(duration, callback);
+          timers.add(timer);
+          return timer;
+        },
+      );
+    });
+
+    test('schedules once when going to background', () {
+      scheduler.onLifecycleChanged(AppLifecycleState.hidden);
+      scheduler.onLifecycleChanged(AppLifecycleState.paused);
+      expect(timers, hasLength(1));
+      expect(timers.single.duration, const Duration(minutes: 3));
+    });
+
+    test('resume cancels', () {
+      scheduler.onLifecycleChanged(AppLifecycleState.paused);
+      scheduler.onLifecycleChanged(AppLifecycleState.resumed);
+      expect(timers.single.cancelled, isTrue);
+      expect(scheduler.isScheduled, isFalse);
+    });
+
+    test('inactive does not schedule or cancel', () {
+      scheduler.onLifecycleChanged(AppLifecycleState.inactive);
+      expect(timers, isEmpty);
+      scheduler.onLifecycleChanged(AppLifecycleState.paused);
+      scheduler.onLifecycleChanged(AppLifecycleState.inactive);
+      expect(timers.single.cancelled, isFalse);
+    });
+
+    test('disabled setting never schedules', () {
+      setting = const LightModeSetting();
+      scheduler.onLifecycleChanged(AppLifecycleState.paused);
+      expect(timers, isEmpty);
+    });
+
+    test('fires only when still enabled and the core is running', () {
+      scheduler.onLifecycleChanged(AppLifecycleState.paused);
+      timers.single.callback();
+      expect(entered, 1);
+
+      scheduler.onLifecycleChanged(AppLifecycleState.paused);
+      running = false;
+      timers.last.callback();
+      expect(entered, 1);
+
+      scheduler.onLifecycleChanged(AppLifecycleState.paused);
+      setting = const LightModeSetting();
+      timers.last.callback();
+      expect(entered, 1);
+    });
+
+    test('a failing enter does not escape', () async {
+      final failing = LightModeScheduler(
+        readSetting: () => setting,
+        isCoreRunning: () => true,
+        enter: () async => throw StateError('boom'),
+        createTimer: (duration, callback) {
+          final timer = _FakeTimer(duration, callback);
+          timers.add(timer);
+          return timer;
+        },
+      );
+      failing.onLifecycleChanged(AppLifecycleState.paused);
+      timers.single.callback();
+      await Future<void>.delayed(Duration.zero);
+    });
+  });
+}
