+++ b/test/common/favorite_proxies_test.dart	2026-10-26 00:37:15.509080081 +0900
@@ -0,0 +1,62 @@
+import 'package:fl_clash/common/favorite_proxies.dart';
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/models.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  const a = FavoriteProxy('Proxy', 'HK 01');
+  const b = FavoriteProxy('Proxy', 'JP 01');
+
+  test('toggle adds then removes, keeping order', () {
+    var list = toggleFavorite(const [], a);
+    list = toggleFavorite(list, b);
+    expect(list, [a, b]);
+    expect(toggleFavorite(list, a), [b]);
+  });
+
+  test('encode/decode round trip', () {
+    final map = {
+      '1': [a, b],
+      '2': [a],
+    };
+    expect(decodeFavorites(encodeFavorites(map)), map);
+  });
+
+  test('decode tolerates garbage', () {
+    expect(decodeFavorites(null), isEmpty);
+    expect(decodeFavorites(''), isEmpty);
+    expect(decodeFavorites('not json'), isEmpty);
+    expect(decodeFavorites('[1,2]'), isEmpty);
+    final map = decodeFavorites(
+      '{"1":[{"group":"g","name":"n"},{"group":1},"x",{"group":"g","name":"n"}],"2":"bad"}',
+    );
+    expect(map, {
+      '1': [const FavoriteProxy('g', 'n')],
+    });
+  });
+
+  test('prune drops unknown profiles but never everything when unloaded', () {
+    final map = {
+      '1': [a],
+      '2': [b],
+    };
+    expect(pruneFavorites(map, {'1'}).keys, ['1']);
+    expect(pruneFavorites(map, {}), map);
+  });
+
+  test('resolve finds group and proxy, or reports missing', () {
+    final groups = [
+      const Group(
+        type: GroupType.Selector,
+        name: 'Proxy',
+        all: [Proxy(name: 'HK 01', type: 'ss')],
+      ),
+    ];
+    final hit = resolveFavorite(a, groups);
+    expect(hit.exists, isTrue);
+    expect(hit.group!.name, 'Proxy');
+    expect(resolveFavorite(b, groups).exists, isFalse);
+    expect(resolveFavorite(const FavoriteProxy('X', 'HK 01'), groups).group,
+        isNull);
+  });
+}
