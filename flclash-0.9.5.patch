+
+class SettingsSearchEntry {
+  final String title;
+  final String? description;
+  final String path;
+  final Widget Function(BuildContext context) pageBuilder;
+
+  const SettingsSearchEntry({
+    required this.title,
+    this.description,
+    required this.path,
+    required this.pageBuilder,
+  });
+}
+
+List<SettingsSearchEntry> filterSettingsEntries(
+  List<SettingsSearchEntry> entries,
+  String query,
+) {
+  final lowQuery = query.trim().toLowerCase();
+  if (lowQuery.isEmpty) {
+    return const [];
+  }
+  final titleMatches = <SettingsSearchEntry>[];
+  final otherMatches = <SettingsSearchEntry>[];
+  final seen = <String>{};
+  for (final entry in entries) {
+    final id = '${entry.path}\n${entry.title}';
+    if (!seen.add(id)) {
+      continue;
+    }
+    if (matchesWithPinyin(entry.title, lowQuery)) {
+      titleMatches.add(entry);
+    } else if ((entry.description?.toLowerCase().contains(lowQuery) ??
+            false) ||
+        entry.path.toLowerCase().contains(lowQuery)) {
+      otherMatches.add(entry);
+    }
+  }
+  return [...titleMatches, ...otherMatches];
+}
+
+List<SettingsSearchEntry> buildSettingsSearchEntries(AppLocalizations l) {
+  final tools = l.tools;
+  final basic = l.basicConfig;
+  final advanced = l.advancedConfig;
+  final networkPath = '$advanced › ${l.network}';
+  final dnsPath = '$advanced › DNS';
+  final application = l.application;
+
+  SettingsSearchEntry page(
+    String title,
+    String? description,
+    String path,
+    Widget Function(BuildContext context) builder,
+  ) {
+    return SettingsSearchEntry(
+      title: title,
+      description: description,
+      path: path,
+      pageBuilder: builder,
+    );
+  }
+
+  Widget basicPage(BuildContext _) => const ConfigView();
+  Widget networkPage(BuildContext _) => const NetworkSettingView();
+  Widget dnsPage(BuildContext _) => const DnsSettingView();
+  Widget applicationPage(BuildContext _) => const ApplicationSettingView();
+
+  SettingsSearchEntry basicItem(String title, [String? description]) =>
+      page(title, description, basic, basicPage);
+  SettingsSearchEntry networkItem(String title, [String? description]) =>
+      page(title, description, networkPath, networkPage);
+  SettingsSearchEntry dnsItem(String title, [String? description]) =>
+      page(title, description, dnsPath, dnsPage);
+  SettingsSearchEntry applicationItem(String title, [String? description]) =>
+      page(title, description, application, applicationPage);
+
+  return [
+    page(l.theme, l.themeDesc, tools, (_) => const ThemeView()),
+    page(
