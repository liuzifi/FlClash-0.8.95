+String pinyinInitials(String text) {
+  final buffer = StringBuffer();
+  for (final rune in text.runes) {
+    if (rune >= _firstHan && rune <= _lastHan) {
+      buffer.writeCharCode(_initials.codeUnitAt(rune - _firstHan));
+    } else {
+      buffer.writeCharCode(rune);
+    }
+  }
+  return buffer.toString();
+}
+
+final Map<String, String> _keyCache = {};
+
+String pinyinSortKey(String text) {
+  return _keyCache.putIfAbsent(text, () {
+    final lower = pinyinInitials(text).toLowerCase();
+    return lower.replaceAll(RegExp(r'\s+'), '');
+  });
+}
+
+bool matchesWithPinyin(String text, String query) {
+  if (query.isEmpty) {
+    return true;
+  }
+  if (text.toLowerCase().contains(query)) {
+    return true;
+  }
+  return pinyinSortKey(text).contains(query);
+}
+
+int compareWithPinyin(String a, String b) {
+  final result = pinyinSortKey(a).compareTo(pinyinSortKey(b));
+  if (result != 0) {
+    return result;
+  }
+  return a.compareTo(b);
+}
