+import 'package:fl_clash/providers/database.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+class FavoriteProxiesNotifier extends Notifier<FavoriteMap> {
+  @override
+  FavoriteMap build() {
+    _load();
+    return const {};
+  }
+
+  Future<void> _load() async {
+    final loaded = decodeFavorites(await preferences.getFavoriteProxies());
+    state = {...loaded, ...state};
+  }
+
+  void toggle(String profileId, FavoriteProxy favorite) {
+    final next = toggleFavorite(state[profileId] ?? const [], favorite);
+    state = {...state, profileId: next};
+    _persist();
+  }
+
+  Future<void> _persist() async {
+    final valid = ref
+        .read(profilesProvider)
+        .map((profile) => profile.id.toString())
+        .toSet();
+    await preferences.saveFavoriteProxies(
+      encodeFavorites(pruneFavorites(state, valid)),
+    );
+  }
+}
+
+final favoriteProxiesProvider =
+    NotifierProvider<FavoriteProxiesNotifier, FavoriteMap>(
+      FavoriteProxiesNotifier.new,
+    );
+
+final currentFavoriteProxiesProvider = Provider<List<FavoriteProxy>>((ref) {
+  final profileId = ref.watch(currentProfileIdProvider);
+  if (profileId == null) return const [];
+  return ref.watch(favoriteProxiesProvider)[profileId.toString()] ?? const [];
+});
