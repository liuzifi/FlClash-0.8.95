@@ -0,0 +1,25 @@
+import 'package:fl_clash/common/pinyin.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('pinyinInitials converts han characters and keeps others', () {
+    expect(pinyinInitials('微信'), 'wx');
+    expect(pinyinInitials('支付宝'), 'zfb');
+    expect(pinyinInitials('淘宝 App'), 'tb App');
+    expect(pinyinInitials('Chrome'), 'Chrome');
+  });
+
+  test('matchesWithPinyin matches initials and original text', () {
+    expect(matchesWithPinyin('微信', 'wx'), isTrue);
+    expect(matchesWithPinyin('微信 WeChat', 'wechat'), isTrue);
+    expect(matchesWithPinyin('微信', '微'), isTrue);
+    expect(matchesWithPinyin('微信', 'zf'), isFalse);
+    expect(matchesWithPinyin('anything', ''), isTrue);
+  });
+
+  test('compareWithPinyin interleaves han and latin labels', () {
+    final labels = ['微信', 'Chrome', '支付宝', 'Alipay', '淘宝', 'WeChat'];
+    labels.sort(compareWithPinyin);
+    expect(labels, ['Alipay', 'Chrome', '淘宝', 'WeChat', '微信', '支付宝']);
+  });
+}
diff -ruN orig/FlClash-0.8.95-0.9.1/test/common/yaml_folding_test.dart fl/FlClash-0.8.95-0.9.1/test/common/yaml_folding_test.dart
--- orig/FlClash-0.8.95-0.9.1/test/common/yaml_folding_test.dart	1970-01-01 09:00:00.000000000 +0900
+++ fl/FlClash-0.8.95-0.9.1/test/common/yaml_folding_test.dart	2026-10-22 18:58:39.143340884 +0900
@@ -0,0 +1,44 @@
+import 'package:fl_clash/common/yaml_folding.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+List<FoldRange> fold(String text) => computeYamlFoldRanges(text.split('\n'));
+
+void main() {
+  test('nested mappings', () {
+    final r = fold('a:\n  b:\n    c: 1\n  d: 2\ne: 3');
+    expect(r, [const FoldRange(0, 3), const FoldRange(1, 2)]);
+  });
+
+  test('sequence at the same column folds under its key', () {
+    final r = fold('proxies:\n- name: a\n  type: x\n- name: b\n  type: y\nrules:\n- A\n- B');
+    expect(r, contains(const FoldRange(0, 4)));
+    expect(r, contains(const FoldRange(1, 2)));
+    expect(r, contains(const FoldRange(3, 4)));
+    expect(r, contains(const FoldRange(5, 7)));
+  });
+
+  test('indented sequence still works', () {
+    final r = fold('rules:\n  - A\n  - B\nnext: 1');
+    expect(r, [const FoldRange(0, 2)]);
+  });
+
+  test('trailing blank and comment lines are excluded', () {
+    final r = fold('a:\n  b: 1\n\n# note\nc: 2');
+    expect(r, [const FoldRange(0, 1)]);
+  });
+
+  test('comments do not close or open blocks', () {
+    final r = fold('a:\n  b: 1\n# top comment\n  c: 2\nd: 3');
+    expect(r, [const FoldRange(0, 3)]);
+  });
+
+  test('block scalar content folds with its key', () {
+    final r = fold('script: |\n  line1\n\n  line2\nnext: 1');
+    expect(r, [const FoldRange(0, 3)]);
+  });
+
+  test('top-level sequence items and empty input', () {
+    expect(fold('- a: 1\n  b: 2\n- c: 3'), [const FoldRange(0, 1)]);
+    expect(fold(''), isEmpty);
+  });
+}
diff -ruN orig/FlClash-0.8.95-0.9.1/test/common/yaml_outline_test.dart fl/FlClash-0.8.95-0.9.1/test/common/yaml_outline_test.dart
--- orig/FlClash-0.8.95-0.9.1/test/common/yaml_outline_test.dart	1970-01-01 09:00:00.000000000 +0900
+++ fl/FlClash-0.8.95-0.9.1/test/common/yaml_outline_test.dart	2026-10-21 08:28:08.387315129 +0900
@@ -0,0 +1,76 @@
+import 'package:fl_clash/common/yaml_outline.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  group('parseErrorLine', () {
+    test('reads the line number from yaml errors', () {
+      expect(parseErrorLine('yaml: line 12: did not find expected key'), 12);
+      expect(
+        parseErrorLine('yaml: unmarshal errors:\n  line 7: cannot unmarshal'),
+        7,
+      );
+    });
+
+    test('returns null without a line number', () {
+      expect(parseErrorLine('proxy 0: missing type'), isNull);
+      expect(parseErrorLine('line 0: x'), isNull);
+    });
+  });
+
+  group('parseYamlOutline', () {
+    test('lists sections and named children', () {
+      const text = '''
+mixed-port: 7890
+proxies:
+  - name: "node a"
+    type: ss
+  - type: vmess
+    name: node b
+  - {name: node c, type: trojan}
+proxy-groups:
+  - name: Proxy
+    proxies:
+      - node a
+rules:
+  - DOMAIN,google.com,Proxy
+  - IP-CIDR6,2001:db8::/32,Proxy
+dns:
+  enable: true
+  nameserver:
+    - 1.1.1.1
+''';
+      final items = parseYamlOutline(text);
+      final titles = items.map((e) => '${e.level}:${e.title}').toList();
+      expect(titles, [
+        '0:mixed-port',
+        '0:proxies',
+        '1:node a',
+        '1:node b',
+        '1:node c',
+        '0:proxy-groups',
+        '1:Proxy',
+        '0:rules',
+        '1:DOMAIN,google.com,Proxy',
+        '1:IP-CIDR6,2001:db8::/32,Proxy',
+        '0:dns',
+        '1:enable',
+        '1:nameserver',
+      ]);
+      expect(items[1].line, 1);
+      expect(items[2].line, 2);
+    });
+
+    test('supports sequences without indentation', () {
+      const text = 'proxies:\n- name: a\n  type: ss\n- name: b\n  type: ss\n';
+      final items = parseYamlOutline(text);
+      expect(items.map((e) => e.title).toList(), ['proxies', 'a', 'b']);
+      expect(items.map((e) => e.line).toList(), [0, 1, 3]);
+    });
+
+    test('numbers unnamed items', () {
+      const text = 'proxies:\n  - type: ss\n  - type: ss\n';
+      final items = parseYamlOutline(text);
+      expect(items.map((e) => e.title).toList(), ['proxies', '#1', '#2']);
+    });
+  });
+}
diff -ruN orig/FlClash-0.8.95-0.9.1/test/providers/filter_groups_test.dart fl/FlClash-0.8.95-0.9.1/test/providers/filter_groups_test.dart
--- orig/FlClash-0.8.95-0.9.1/test/providers/filter_groups_test.dart	1970-01-01 09:00:00.000000000 +0900
+++ fl/FlClash-0.8.95-0.9.1/test/providers/filter_groups_test.dart	2026-10-21 19:10:32.251006617 +0900
@@ -0,0 +1,68 @@
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/models.dart';
+import 'package:fl_clash/providers/state.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+Group _group(String name, List<String> proxies) {
+  return Group(
+    type: GroupType.Selector,
+    name: name,
+    all: proxies.map((item) => Proxy(name: item, type: 'ss')).toList(),
+  );
+}
+
+void main() {
+  late ProviderContainer container;
+
+  setUp(() {
+    container = ProviderContainer(
+      overrides: [
+        currentGroupsStateProvider.overrideWithValue(
+          GroupsState(
+            value: [
+              _group('Proxy', ['香港 01', 'US West', '日本 02']),
+              _group('Netflix', ['香港 01', 'US East']),
+              _group('Direct', ['DIRECT']),
+            ],
+          ),
+        ),
+      ],
+    );
+  });
+
+  tearDown(() {
+    container.dispose();
+  });
+
+  List<Group> filter(String query) {
+    return container.read(filterGroupsStateProvider(query)).value;
+  }
+
+  test('empty or blank query keeps every group', () {
+    expect(filter(''), hasLength(3));
+    expect(filter('  '), hasLength(3));
+  });
+
+  test('matches node names ignoring case', () {
+    final groups = filter('US');
+    expect(groups.map((group) => group.name), ['Proxy', 'Netflix']);
+    expect(groups.first.all.map((proxy) => proxy.name), ['US West']);
+  });
+
+  test('matches node names by pinyin initials', () {
+    final groups = filter('xg');
+    expect(groups.map((group) => group.name), ['Proxy', 'Netflix']);
+    expect(groups.first.all.single.name, '香港 01');
+  });
+
+  test('a group name match keeps the whole group', () {
+    final groups = filter('netflix');
+    expect(groups.single.name, 'Netflix');
+    expect(groups.single.all, hasLength(2));
+  });
+
+  test('groups without matches are dropped', () {
+    expect(filter('zzz'), isEmpty);
+  });
+}
diff -ruN orig/FlClash-0.8.95-0.9.1/test/views/settings_search_test.dart fl/FlClash-0.8.95-0.9.1/test/views/settings_search_test.dart
