@@ -0,0 +1,52 @@
+import 'package:fl_clash/common/dns_validator.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('valid dns servers', () {
+    for (final s in [
+      '223.5.5.5',
+      '223.5.5.5:53',
+      '2400:3200::1',
+      '[2400:3200::1]:53',
+      'dns.alidns.com',
+      'tls://dns.google:853',
+      'https://dns.alidns.com/dns-query',
+      'https://1.1.1.1/dns-query#proxy',
+      'quic://dns.adguard.com',
+      'udp://8.8.8.8',
+      'system',
+      'dhcp://en0',
+      'rcode://success',
+    ]) {
+      expect(isValidDnsServer(s), isTrue, reason: s);
+    }
+  });
+
+  test('invalid dns servers', () {
+    for (final s in [
+      '',
+      ' ',
+      '8.8.8.8:99999',
+      '8.8.8.8:0',
+      'ftp://8.8.8.8',
+      'tls://',
+      'tls://dns.google/path',
+      'a b',
+      '#proxy',
+      '1.2.3.4.5:53x',
+      '-bad.com',
+    ]) {
+      expect(isValidDnsServer(s), isFalse, reason: s);
+    }
+  });
+
+  test('server list and cidr', () {
+    expect(isValidDnsServerList('1.1.1.1, tls://dns.google'), isTrue);
+    expect(isValidDnsServerList('1.1.1.1,,'), isFalse);
+    expect(isValidCidr('198.18.0.1/16'), isTrue);
+    expect(isValidCidr('fc00::/7'), isTrue);
+    expect(isValidCidr('198.18.0.1/33'), isFalse);
+    expect(isValidCidr('198.18.0.1'), isFalse);
+    expect(isValidCidr('x/8'), isFalse);
+  });
+}
diff -ruN orig/FlClash-0.8.95-0.9.1/test/common/editor_draft_test.dart fl/FlClash-0.8.95-0.9.1/test/common/editor_draft_test.dart
--- orig/FlClash-0.8.95-0.9.1/test/common/editor_draft_test.dart	1970-01-01 09:00:00.000000000 +0900
+++ fl/FlClash-0.8.95-0.9.1/test/common/editor_draft_test.dart	2026-10-22 18:55:26.802268120 +0900
@@ -0,0 +1,47 @@
+import 'dart:io';
+
+import 'package:fl_clash/common/editor_draft.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  late Directory dir;
+  late EditorDraft draft;
+
+  setUp(() async {
+    dir = await Directory.systemTemp.createTemp('draft_test');
+    draft = EditorDraft(dir);
+  });
+
+  tearDown(() async {
+    await dir.delete(recursive: true);
+  });
+
+  test('stableHash is deterministic and content sensitive', () {
+    expect(stableHash('abc'), stableHash('abc'));
+    expect(stableHash('abc'), isNot(stableHash('abd')));
+  });
+
+  test('round trip', () async {
+    await draft.save('p/1', 'base', 'edited');
+    expect(await draft.load('p/1', 'base'), 'edited');
+  });
+
+  test('stale draft (base changed) is dropped and deleted', () async {
+    await draft.save('k', 'old', 'edited');
+    expect(await draft.load('k', 'new'), isNull);
+    expect(await draft.load('k', 'old'), isNull);
+  });
+
+  test('draft equal to base is not offered', () async {
+    await draft.save('k', 'same', 'same');
+    expect(await draft.load('k', 'same'), isNull);
+  });
+
+  test('clear and corrupt file', () async {
+    await draft.save('k', 'a', 'b');
+    await draft.clear('k');
+    expect(await draft.load('k', 'a'), isNull);
+    await File('${dir.path}/bad.json').writeAsString('not json');
+    expect(await draft.load('bad', 'a'), isNull);
+  });
+}
