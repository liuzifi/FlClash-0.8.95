+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+/// Shows the active profile and the node currently selected in its main
+/// group. Tapping it opens the proxies page (or the profiles page when there
+/// are no proxies yet).
+class CurrentProfileCard extends ConsumerWidget {
+  const CurrentProfileCard({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final appLocalizations = context.appLocalizations;
+    final profile = ref.watch(currentProfileProvider);
+    final groups = ref.watch(currentGroupsStateProvider).value;
+    final currentGroupName = profile?.currentGroupName;
+    final group = groups.isEmpty
+        ? null
+        : groups.firstWhere(
+            (item) => item.name == currentGroupName,
+            orElse: () => groups.first,
+          );
+    final nodeName = group == null
+        ? null
+        : ref.watch(selectedProxyNameProvider(group.name));
+    final title = profile == null
+        ? appLocalizations.none
+        : profile.label.takeFirstValid([profile.id.toString()]);
+    final subtitle = group == null
+        ? null
+        : nodeName == null || nodeName.isEmpty
+        ? group.name
+        : '${group.name} › $nodeName';
+    return SizedBox(
+      height: getWidgetHeight(1),
+      child: CommonCard(
+        info: Info(
+          label: appLocalizations.currentProfile,
+          iconData: Icons.article_outlined,
+        ),
+        onPressed: () {
+          globalState.container
+              .read(currentPageLabelProvider.notifier)
+              .toPage(group == null ? PageLabel.profiles : PageLabel.proxies);
+        },
+        child: Container(
+          padding: baseInfoEdgeInsets.copyWith(top: 0),
+          child: Column(
+            mainAxisSize: MainAxisSize.max,
+            mainAxisAlignment: MainAxisAlignment.end,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              TooltipText(
+                text: Text(
+                  title,
+                  style: context.textTheme.titleMedium,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                ),
+              ),
+              if (subtitle != null)
+                TooltipText(
+                  text: Text(
+                    subtitle,
+                    style: context.textTheme.bodyMedium?.toLight,
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                  ),
+                ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
