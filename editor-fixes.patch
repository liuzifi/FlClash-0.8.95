+class _UpdateAllItem extends ConsumerStatefulWidget {
+  const _UpdateAllItem();
+
+  @override
+  ConsumerState<_UpdateAllItem> createState() => _UpdateAllItemState();
+}
+
+class _UpdateAllItemState extends ConsumerState<_UpdateAllItem> {
+  bool _updating = false;
+
+  Future<void> _handleUpdateAll() async {
+    if (_updating) {
+      return;
+    }
+    setState(() {
+      _updating = true;
+    });
+    try {
+      for (final geoResource in GeoResource.values) {
+        // One failure should not stop the remaining resources.
+        await globalState.safeRun<void>(() async {
+          await ref
+              .read(geoResourceActionProvider.notifier)
+              .updateGeoResource(geoResource);
+        }, silence: false);
+      }
+    } finally {
+      if (mounted) {
+        setState(() {
+          _updating = false;
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return ListItem(
+      leading: _updating
+          ? const SizedBox(
+              height: 24,
+              width: 24,
+              child: Padding(
+                padding: EdgeInsets.all(2),
+                child: CommonCircleLoading(),
+              ),
+            )
+          : const Icon(Icons.sync),
+      title: Text(context.appLocalizations.updateAll),
+      onTap: _updating ? null : _handleUpdateAll,
+    );
+  }
+}
 
