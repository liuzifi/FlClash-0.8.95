diff -ruN orig/FlClash-0.8.95-0.9.1/lib/common/dns_validator.dart fl/FlClash-0.8.95-0.9.1/lib/common/dns_validator.dart
--- orig/FlClash-0.8.95-0.9.1/lib/common/dns_validator.dart	1970-01-01 09:00:00.000000000 +0900
+++ fl/FlClash-0.8.95-0.9.1/lib/common/dns_validator.dart	2026-10-22 13:27:06.073923324 +0900
@@ -0,0 +1,102 @@
+/// Lightweight format checks for DNS settings. They only reject input that is
+/// obviously wrong; anything mihomo may accept is allowed through.
+const _dnsSchemes = {
+  'udp', 'tcp', 'tls', 'https', 'quic', 'h3', 'dhcp', 'system', 'rcode',
+};
+
+final _hostLabel = RegExp(r'^[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?$');
+
+bool _isIpv4(String s) {
+  final parts = s.split('.');
+  if (parts.length != 4) return false;
+  return parts.every((p) {
+    final n = int.tryParse(p);
+    return n != null && n >= 0 && n <= 255 && p == n.toString();
+  });
+}
+
+bool _isIpv6(String s) {
+  if (!s.contains(':')) return false;
+  try {
+    Uri.parseIPv6Address(s);
+    return true;
+  } catch (_) {
+    return false;
+  }
+}
+
+bool _isHostname(String s) {
+  if (s.isEmpty || s.length > 253) return false;
+  return s.split('.').every(_hostLabel.hasMatch);
+}
+
+bool _isPort(String s) {
+  final n = int.tryParse(s);
+  return n != null && n > 0 && n <= 65535 && s == n.toString();
+}
+
+/// Validates `host`, `host:port`, `[v6]:port`, bare IPv6.
+bool _isHostPort(String s) {
+  if (s.isEmpty) return false;
+  if (s.startsWith('[')) {
+    final end = s.indexOf(']');
+    if (end < 0) return false;
+    final host = s.substring(1, end);
+    final rest = s.substring(end + 1);
+    if (!_isIpv6(host)) return false;
+    return rest.isEmpty || (rest.startsWith(':') && _isPort(rest.substring(1)));
+  }
+  if (_isIpv6(s)) return true;
+  final idx = s.lastIndexOf(':');
+  if (idx >= 0) {
+    if (s.indexOf(':') != idx) return false;
+    if (!_isPort(s.substring(idx + 1))) return false;
+    s = s.substring(0, idx);
+  }
+  return _isIpv4(s) || _isHostname(s);
+}
+
+/// One nameserver entry, e.g. `223.5.5.5`, `tls://dns.google:853`,
+/// `https://dns.alidns.com/dns-query#proxy`, `system`, `dhcp://en0`.
+bool isValidDnsServer(String input) {
+  var value = input.trim();
+  if (value.isEmpty || value.contains(RegExp(r'\s'))) return false;
+  final hash = value.indexOf('#');
+  if (hash >= 0) {
+    value = value.substring(0, hash);
+    if (value.isEmpty) return false;
+  }
+  if (value == 'system') return true;
+  final sep = value.indexOf('://');
+  if (sep < 0) return _isHostPort(value);
+  final scheme = value.substring(0, sep).toLowerCase();
+  if (!_dnsSchemes.contains(scheme)) return false;
+  var rest = value.substring(sep + 3);
+  if (rest.isEmpty) return false;
+  if (scheme == 'dhcp' || scheme == 'rcode') return true;
+  final slash = rest.indexOf('/');
+  if (slash >= 0) {
+    if (scheme != 'https' && scheme != 'h3') return false;
+    rest = rest.substring(0, slash);
+  }
+  return _isHostPort(rest);
+}
+
+/// Value of a nameserver-policy entry: one server or a comma separated list.
+bool isValidDnsServerList(String input) {
+  final parts = input.split(',').map((e) => e.trim()).toList();
+  return parts.isNotEmpty && parts.every(isValidDnsServer);
+}
+
+/// `198.18.0.1/16` or `fc00::/7`.
+bool isValidCidr(String input) {
+  final value = input.trim();
+  final slash = value.indexOf('/');
+  if (slash <= 0) return false;
+  final ip = value.substring(0, slash);
+  final bits = int.tryParse(value.substring(slash + 1));
+  if (bits == null || bits < 0) return false;
+  if (_isIpv4(ip)) return bits <= 32;
+  if (_isIpv6(ip)) return bits <= 128;
+  return false;
+}
diff -ruN orig/FlClash-0.8.95-0.9.1/lib/common/editor_draft.dart fl/FlClash-0.8.95-0.9.1/lib/common/editor_draft.dart
--- orig/FlClash-0.8.95-0.9.1/lib/common/editor_draft.dart	1970-01-01 09:00:00.000000000 +0900
+++ fl/FlClash-0.8.95-0.9.1/lib/common/editor_draft.dart	2026-10-22 18:55:26.799828060 +0900
@@ -0,0 +1,62 @@
+import 'dart:convert';
+import 'dart:io';
+
+/// FNV-1a 32-bit hash. Unlike [String.hashCode] it is stable across runs, so
+/// it can be persisted next to a draft.
+int stableHash(String text) {
+  var hash = 0x811c9dc5;
+  for (final unit in text.codeUnits) {
+    hash ^= unit;
+    hash = (hash * 0x01000193) & 0xffffffff;
+  }
+  return hash;
+}
+
+/// Crash-safe drafts for the editor. A draft remembers the hash of the
+/// content it was based on; once the real file changes (for example after a
+/// save) the draft no longer matches and is discarded instead of offered.
+class EditorDraft {
+  final Directory dir;
+
+  const EditorDraft(this.dir);
+
+  File _file(String key) {
+    final safe = key.replaceAll(RegExp(r'[^A-Za-z0-9_.-]'), '_');
+    return File('${dir.path}${Platform.pathSeparator}$safe.json');
+  }
+
+  Future<void> save(String key, String base, String text) async {
+    final file = _file(key);
+    await file.create(recursive: true);
+    await file.writeAsString(
+      json.encode({'base': stableHash(base), 'text': text}),
+    );
+  }
+
+  /// The draft text, or null when there is none, it is stale, or it equals
+  /// [base]. Stale and unreadable drafts are deleted.
+  Future<String?> load(String key, String base) async {
+    final file = _file(key);
+    if (!await file.exists()) {
+      return null;
+    }
+    try {
+      final data = json.decode(await file.readAsString());
+      final text = data['text'];
+      if (data['base'] == stableHash(base) &&
+          text is String &&
+          text != base) {
+        return text;
+      }
+    } catch (_) {}
+    await clear(key);
+    return null;
+  }
+
+  Future<void> clear(String key) async {
+    final file = _file(key);
+    if (await file.exists()) {
+      await file.delete();
+    }
+  }
+}
diff -ruN orig/FlClash-0.8.95-0.9.1/lib/common/geo_mirror.dart fl/FlClash-0.8.95-0.9.1/lib/common/geo_mirror.dart
--- orig/FlClash-0.8.95-0.9.1/lib/common/geo_mirror.dart	1970-01-01 09:00:00.000000000 +0900
+++ fl/FlClash-0.8.95-0.9.1/lib/common/geo_mirror.dart	2026-10-22 08:22:15.093493521 +0900
@@ -0,0 +1,33 @@
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/clash_config.dart';
+
+class GeoMirrorPreset {
+  final String name;
+  final Map<GeoResource, String> urls;
+
+  const GeoMirrorPreset(this.name, this.urls);
+}
+
+const _jsdelivrBase =
+    'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release';
+
+const geoMirrorPresets = <GeoMirrorPreset>[
+  GeoMirrorPreset('GitHub', defaultGeoXUrl),
+  GeoMirrorPreset('jsDelivr', {
+    GeoResource.MMDB: '$_jsdelivrBase/geoip.metadb',
+    GeoResource.ASN: '$_jsdelivrBase/GeoLite2-ASN.mmdb',
+    GeoResource.GEOIP: '$_jsdelivrBase/geoip.dat',
+    GeoResource.GEOSITE: '$_jsdelivrBase/geosite.dat',
+  }),
+];
+
+/// The preset whose URLs exactly equal [current], or null for custom URLs.
+GeoMirrorPreset? detectGeoMirrorPreset(Map<GeoResource, String> current) {
+  for (final preset in geoMirrorPresets) {
+    final same = preset.urls.entries.every((e) => current[e.key] == e.value);
+    if (same) {
+      return preset;
+    }
+  }
+  return null;
+}
