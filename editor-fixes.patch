+import 'package:fl_clash/views/settings_search.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+SettingsSearchEntry _e(String title, {String? desc, String path = 'Tools'}) {
+  return SettingsSearchEntry(
+    title: title,
+    description: desc,
+    path: path,
+    pageBuilder: (_) => const SizedBox(),
+  );
+}
+
+void main() {
+  final entries = [
+    _e('主题', desc: '设置应用主题'),
+    _e('网络', path: '高级配置'),
+    _e('允许局域网', desc: '允许局域网连接', path: '基础配置'),
+    _e('Hosts', desc: 'Override hosts'),
+    _e('Hosts', desc: 'Override hosts'),
+  ];
+
+  test('empty or blank query returns nothing', () {
+    expect(filterSettingsEntries(entries, ''), isEmpty);
+    expect(filterSettingsEntries(entries, '   '), isEmpty);
+  });
+
+  test('matches pinyin initials', () {
+    final r = filterSettingsEntries(entries, 'zt');
+    expect(r.map((e) => e.title), ['主题']);
+  });
+
+  test('title matches rank before description/path matches', () {
+    final r = filterSettingsEntries(entries, '主题');
+    expect(r.first.title, '主题');
+  });
+
+  test('matches path and description, case-insensitive, dedupes', () {
+    expect(filterSettingsEntries(entries, '高级').map((e) => e.title), ['网络']);
+    expect(filterSettingsEntries(entries, 'HOSTS').length, 1);
+  });
+}
