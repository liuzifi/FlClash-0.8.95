+
+class SettingsSearchEntry {
+  final String title;
+  final String? description;
+  final String path;
+  final Widget Function(BuildContext context) pageBuilder;
+
+  const SettingsSearchEntry({
+    required this.title,
+    this.description,
+    required this.path,
+    required this.pageBuilder,
+  });
+}
+
+List<SettingsSearchEntry> filterSettingsEntries(
+  List<SettingsSearchEntry> entries,
+  String query,
+) {
+  final lowQuery = query.trim().toLowerCase();
+  if (lowQuery.isEmpty) {
+    return const [];
+  }
+  final titleMatches = <SettingsSearchEntry>[];
+  final otherMatches = <SettingsSearchEntry>[];
+  final seen = <String>{};
+  for (final entry in entries) {
+    final id = '${entry.path}\n${entry.title}';
+    if (!seen.add(id)) {
+      continue;
+    }
+    if (matchesWithPinyin(entry.title, lowQuery)) {
+      titleMatches.add(entry);
+    } else if ((entry.description?.toLowerCase().contains(lowQuery) ??
+            false) ||
+        entry.path.toLowerCase().contains(lowQuery)) {
+      otherMatches.add(entry);
+    }
+  }
+  return [...titleMatches, ...otherMatches];
+}
+
+List<SettingsSearchEntry> buildSettingsSearchEntries(AppLocalizations l) {
+  final tools = l.tools;
+  final basic = l.basicConfig;
+  final advanced = l.advancedConfig;
+  final networkPath = '$advanced › ${l.network}';
+  final dnsPath = '$advanced › DNS';
+  final application = l.application;
+
+  SettingsSearchEntry page(
+    String title,
+    String? description,
+    String path,
+    Widget Function(BuildContext context) builder,
+  ) {
+    return SettingsSearchEntry(
+      title: title,
+      description: description,
+      path: path,
+      pageBuilder: builder,
+    );
+  }
+
+  Widget basicPage(BuildContext _) => const ConfigView();
+  Widget networkPage(BuildContext _) => const NetworkSettingView();
+  Widget dnsPage(BuildContext _) => const DnsSettingView();
+  Widget applicationPage(BuildContext _) => const ApplicationSettingView();
+
+  SettingsSearchEntry basicItem(String title, [String? description]) =>
+      page(title, description, basic, basicPage);
+  SettingsSearchEntry networkItem(String title, [String? description]) =>
+      page(title, description, networkPath, networkPage);
+  SettingsSearchEntry dnsItem(String title, [String? description]) =>
+      page(title, description, dnsPath, dnsPage);
+  SettingsSearchEntry applicationItem(String title, [String? description]) =>
+      page(title, description, application, applicationPage);
+
+  return [
+    page(l.theme, l.themeDesc, tools, (_) => const ThemeView()),
+    page(
+      l.backupAndRestore,
+      l.backupAndRestoreDesc,
+      tools,
+      (_) => const BackupAndRestore(),
+    ),
+    if (system.isDesktop)
+      page(
+        l.hotkeyManagement,
+        l.hotkeyManagementDesc,
+        tools,
+        (_) => const HotKeyView(),
+      ),
+    if (system.isAndroid)
+      page(
+        l.accessControl,
+        l.accessControlDesc,
+        tools,
+        (_) => const AccessView(),
+      ),
+    page(basic, l.basicConfigDesc, tools, basicPage),
+    page(advanced, l.advancedConfigDesc, tools, (_) {
+      return const AdvancedConfigView();
+    }),
+    page(application, l.applicationDesc, tools, applicationPage),
+    page(l.network, l.networkDesc, advanced, networkPage),
+    page(l.onDemand, l.onDemandDesc, advanced, (_) => const OnDemandView()),
+    page('DNS', l.dnsDesc, advanced, dnsPage),
+    page(
+      l.addedRules,
+      l.controlGlobalAddedRules,
+      advanced,
+      (_) => const AddedRulesView(),
+    ),
+    page(l.script, l.overrideScript, advanced, (_) => const ScriptsView()),
+    basicItem(l.logLevel),
+    basicItem(l.userAgent),
+    if (system.isDesktop) basicItem(l.keepAliveIntervalDesc),
+    basicItem(l.testUrl),
+    basicItem(l.port),
+    basicItem('Hosts', l.hostsDesc),
+    basicItem('IPv6', l.ipv6Desc),
+    basicItem(l.allowLan, l.allowLanDesc),
+    basicItem(l.unifiedDelay, l.unifiedDelayDesc),
+    basicItem(l.appendSystemDns, l.appendSystemDnsTip),
+    basicItem(l.findProcessMode, l.findProcessModeDesc),
+    basicItem(l.tcpConcurrent, l.tcpConcurrentDesc),
+    basicItem(l.geodataLoader, l.geodataLoaderDesc),
+    basicItem(l.externalController, l.externalControllerDesc),
+    if (system.isAndroid) ...[
+      networkItem('VPN', l.vpnEnableDesc),
+      networkItem(l.systemProxy, l.systemProxyDesc),
+      networkItem(l.bypassDomain, l.bypassDomainDesc),
+      networkItem(l.allowBypass, l.allowBypassDesc),
+      networkItem('IPv6', l.ipv6InboundDesc),
+      networkItem(l.dnsHijacking),
+    ],
+    if (system.isDesktop) ...[
+      networkItem(l.systemProxy, l.systemProxyDesc),
+      networkItem(l.bypassDomain, l.bypassDomainDesc),
+      networkItem(l.tun, l.tunDesc),
+    ],
+    if (system.isMacOS) networkItem(l.autoSetSystemDns),
+    networkItem(l.stackMode),
+    if (!system.isDesktop) ...[
+      networkItem(l.routeMode),
+      networkItem(l.routeAddress, l.routeAddressDesc),
+    ],
+    dnsItem(l.overrideDns, l.overrideDnsDesc),
+    dnsItem(l.status, l.statusDesc),
+    dnsItem(l.listen),
+    dnsItem(l.useHosts),
+    dnsItem(l.useSystemHosts),
+    dnsItem('IPv6'),
+    dnsItem(l.respectRules, l.respectRulesDesc),
+    dnsItem('PreferH3', l.preferH3Desc),
+    dnsItem(l.dnsMode),
+    dnsItem(l.fakeipRange),
+    dnsItem(l.fakeipFilter),
+    dnsItem(l.defaultNameserver, l.defaultNameserverDesc),
+    dnsItem(l.nameserverPolicy, l.nameserverPolicyDesc),
