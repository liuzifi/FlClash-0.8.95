diff --git a/transport/xhttp/conn_test.go b/transport/xhttp/conn_test.go
new file mode 100644
index 0000000..e395f5f
--- /dev/null
+++ b/transport/xhttp/conn_test.go
@@ -0,0 +1,75 @@
+package xhttp
+
+import (
+	"io"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Concurrent SetReadDeadline calls must never leak a timer that later closes a live conn.
+func TestConnConcurrentSetDeadlineNoStaleTimer(t *testing.T) {
+	pr, pw := io.Pipe()
+	closed := make(chan struct{}, 1)
+	c := &Conn{writer: pw, reader: pr, onClose: func() { closed <- struct{}{} }}
+
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				_ = c.SetReadDeadline(time.Now().Add(50 * time.Millisecond))
+			}
+		}()
+	}
+	wg.Wait()
+	_ = c.SetReadDeadline(time.Time{}) // clear
+
+	select {
+	case <-closed:
+		t.Fatal("conn was closed by a stale deadline timer")
+	case <-time.After(200 * time.Millisecond):
+	}
+	_ = c.Close()
+}
+
+func TestConnDeadlineClosesAndCloseIsIdempotent(t *testing.T) {
+	pr, pw := io.Pipe()
+	var n int
+	var mu sync.Mutex
+	done := make(chan struct{})
+	c := &Conn{writer: pw, reader: pr, onClose: func() {
+		mu.Lock()
+		n++
+		mu.Unlock()
+		close(done)
+	}}
+	_ = c.SetReadDeadline(time.Now().Add(20 * time.Millisecond))
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("deadline did not close the conn")
+	}
+	_ = c.Close()
+	_ = c.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	if n != 1 {
+		t.Fatalf("onClose called %d times, want 1", n)
+	}
+}
+
+// Clearing the write deadline must not cancel an active read deadline.
+func TestConnReadWriteDeadlineIndependent(t *testing.T) {
+	pr, pw := io.Pipe()
+	done := make(chan struct{})
+	c := &Conn{writer: pw, reader: pr, onClose: func() { close(done) }}
+	_ = c.SetReadDeadline(time.Now().Add(30 * time.Millisecond))
+	_ = c.SetWriteDeadline(time.Time{})
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("read deadline was cancelled by clearing the write deadline")
+	}
+}
